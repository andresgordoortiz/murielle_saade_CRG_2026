// Scheduling follows the locally inspected vast-tools_nextflow CRG configuration.
process {
    executor = 'slurm'
    queue = 'genoa64'
    clusterOptions = {
        if (task.time > 168.h) return '--qos=ethernal'
        if (task.time > 48.h) return '--qos=marathon'
        if (task.time > 24.h) return '--qos=vlong'
        if (task.time > 12.h) return '--qos=long'
        if (task.time > 6.h) return '--qos=normal'
        if (task.time > 3.h) return '--qos=short'
        if (task.time > 1.h) return '--qos=shorter'
        return '--qos=vshort'
    }
    resourceLimits = [cpus: 16, memory: 128.GB, time: 168.h]
}
executor.queueSize = 20
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${System.getenv('SCRATCH_DIR')}/singularity"
    pullTimeout = '60 min'
}
